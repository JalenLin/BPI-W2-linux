From: JalenLin <jalen.lin@gmail.com>
Subject: [PATCH] phy: realtek: add the RTD1295 SATA PHY

The two SATA PHYs of the RTD1295/RTD1296 AHCI controller, which the generic
AHCI platform driver uses through the PHY framework. The driver,
phy-rtd1295-sata.c, is kept in kernel/src and copied in by
scripts/build-kernel.sh; these lines hook it in.

diff --git a/drivers/phy/realtek/Kconfig b/drivers/phy/realtek/Kconfig
--- a/drivers/phy/realtek/Kconfig
+++ b/drivers/phy/realtek/Kconfig
@@ -29,4 +29,13 @@ config PHY_RTK_RTD_USB3PHY
 	  DWC3 USB IP. This driver will do the PHY initialization
 	  of the parameters.
 
+config PHY_RTD1295_SATA
+	tristate "Realtek RTD1295/RTD1296 SATA PHY"
+	depends on OF
+	select GENERIC_PHY
+	select MFD_SYSCON
+	help
+	  The two SATA PHYs of the RTD1295/RTD1296 AHCI controller, which
+	  the generic AHCI platform driver needs on these SoCs.
+
 endif # ARCH_REALTEK || COMPILE_TEST
diff --git a/drivers/phy/realtek/Makefile b/drivers/phy/realtek/Makefile
--- a/drivers/phy/realtek/Makefile
+++ b/drivers/phy/realtek/Makefile
@@ -1,3 +1,4 @@
 # SPDX-License-Identifier: GPL-2.0
 obj-$(CONFIG_PHY_RTK_RTD_USB2PHY)	+= phy-rtk-usb2.o
 obj-$(CONFIG_PHY_RTK_RTD_USB3PHY)	+= phy-rtk-usb3.o
+obj-$(CONFIG_PHY_RTD1295_SATA)	+= phy-rtd1295-sata.o
