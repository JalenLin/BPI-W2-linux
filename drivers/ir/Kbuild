obj-m += rtd1295-ir.o

# Development only: the node as a runtime overlay (scripts/build-overlay.sh
# ir writes ir-overlay.dtso from ir-overlay.dtso.in first).
ifneq ($(wildcard $(src)/ir-overlay.dtso),)
obj-m += ir-overlay-mod.o
ir-overlay-mod-y := ir-overlay.o ir-overlay.dtbo.o
endif

# Development only: rc-core with LIRC and four decoders, which the board's
# kernel lacks (scripts/build-rc-dev.sh copies their sources into rc-dev/).
# Everything here, the IR driver included, is then built with those
# options: struct rc_dev changes with CONFIG_LIRC. Such a build of the
# driver only works with this rc-core.
ifneq ($(wildcard $(src)/rc-dev/rc-main.c),)
ccflags-y += -DCONFIG_LIRC=1 -DCONFIG_IR_NEC_DECODER_MODULE=1 \
	     -DCONFIG_IR_RC5_DECODER_MODULE=1 -DCONFIG_IR_RC6_DECODER_MODULE=1 \
	     -DCONFIG_IR_SONY_DECODER_MODULE=1
obj-m += rc-core.o rc-dev/ir-nec-decoder.o rc-dev/ir-rc5-decoder.o \
	 rc-dev/ir-rc6-decoder.o rc-dev/ir-sony-decoder.o
rc-core-y := rc-dev/rc-main.o rc-dev/rc-ir-raw.o rc-dev/lirc_dev.o
endif
